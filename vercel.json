{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "all"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/auth",
      "dest": "/index.js"
    },
    {
      "src": "/auth/callback",
      "dest": "/index.js"
    },
    {
      "src": "/locales",
      "dest": "/index.js"
    },
    {
      "src": "/products",
      "dest": "/index.js"
    },
    {
      "src": "/localize",
      "dest": "/index.js"
    },
    {
      "src": "/bulk-localize-all",
      "dest": "/index.js"
    },
    {
      "src": "/process-product",
      "dest": "/index.js"
    },
    {
      "src": "/status",
      "dest": "/index.js"
    },
    {
      "src": "/store-settings",
      "dest": "/index.js"
    },
    {
      "src": "/settings",
      "dest": "/index.js"
    },
    {
      "src": "/save-locales",
      "dest": "/index.js"
    },
    {
      "src": "/webhook/(.*)",
      "dest": "/index.js"
    },
    {
      "src": "/dashboard",
      "dest": "/index.js"
    },
    {
      "src": "/tone",
      "dest": "/index.js"
    },
    {
      "src": "/glossary",
      "dest": "/index.js"
    },
    {
      "src": "/products-page",
      "dest": "/index.js"
    },
    {
      "src": "/autosync",
      "dest": "/index.js"
    },
    {
      "src": "/product",
      "dest": "/index.js"
    },
    {
      "src": "/product-translations",
      "dest": "/index.js"
    },
    {
      "src": "/og-image.png",
      "dest": "/public/og-image.png"
    },
    {
      "src": "/favicon.svg",
      "dest": "/public/favicon.svg"
    },
    {
      "src": "/robots.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/poll",
      "dest": "/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.js"
    }
  ],
  "crons": [
    {
      "path": "/poll",
      "schedule": "*/5 * * * *"
    }
  ]
}